        <mxCell id="e10" value="нет" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=13;verticalAlign=bottom;spacingBottom=2;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="read2">
