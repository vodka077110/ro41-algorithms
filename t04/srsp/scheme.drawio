<mxfile host="app.diagrams.net">
  <diagram id="srsp4" name="Схема верхнего уровня">
    <mxGraphModel dx="800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init" value="count = 0&lt;br&gt;sum = 0&lt;br&gt;fives = 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="read1" value="g = Grades.Read()" style="shape=process;size=0.06;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="g ≠ Stop ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="310" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="ok = Grades.IsValid(g)" style="shape=process;size=0.06;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="430" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="ok ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="add" value="count = count + 1&lt;br&gt;sum = sum + g" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="640" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="g = Max ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="740" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="five" value="fives = fives + 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="860" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="read2" value="g = Grades.Read()" style="shape=process;size=0.06;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="990" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="print" value="Grades.PrintStats(count, sum, fives)" style="shape=process;size=0.05;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="1120" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Конец" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="1210" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;" edge="1" parent="1" source="start" target="init">
